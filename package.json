{
  "name": "streamfile-server-nodejs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "src/backend",
    "src/frontend/app"
  ],
  "scripts": {
    "preinstall": "bunx only-allow bun",
    "format": "prettier --write .",
    "dev": "bun scripts/dev.mjs",
    "dev:backend": "bun scripts/dev-backend.mjs",
    "dev:frontend": "bun run --cwd src/frontend/app dev",
    "typecheck": "bun run --cwd src/backend typecheck && bun run --cwd src/frontend/app typecheck",
    "test": "bun run --cwd src/backend test && bun run --cwd src/frontend/app test",
    "test:e2e": "bun run --cwd src/frontend/app test:e2e",
    "build": "bun scripts/build/build.ts"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
