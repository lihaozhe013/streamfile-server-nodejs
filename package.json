    "build": "uv run build.py"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.24",
    "postcss-cli": "^11.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3"
  }
}
